# Copiez ce fichier en bootstrap/repo-credentials.env (ignoré par Git) et
# renseignez un deploy token GitLab en lecture seule (scope read_repository)
# créé sur le dépôt securepay-platform.
# Le fichier est transféré dans la VM par `make bootstrap`, consommé par
# install-argocd.sh, puis supprimé.
PLATFORM_REPO_URL="https://gitlab.com/<groupe>/securepay-platform.git"
GITLAB_DEPLOY_TOKEN_USERNAME="gitlab+deploy-token-000000"
GITLAB_DEPLOY_TOKEN="a-renseigner"
