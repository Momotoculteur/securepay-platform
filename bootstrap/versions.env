# ==============================================================================
# SECUREPAY PLATFORM - VERSIONS ÉPINGLÉES DU SOCLE
# ==============================================================================
# Toute montée de version passe par une Merge Request (contrôle des changements).
# Versions vérifiées sur les dépôts officiels en novembre 2026.
# ==============================================================================

# k3d (k3s dans Docker) - https://github.com/k3d-io/k3d/releases
K3D_VERSION="v5.9.0"

# Image k3s par défaut de k3d v5.9.0 (Kubernetes 1.35)
K3S_IMAGE="rancher/k3s:v1.35.5-k3s1"

# kubectl aligné sur la version mineure du cluster - https://dl.k8s.io/release/stable-1.35.txt
KUBECTL_VERSION="v1.35.10"

# Helm - https://github.com/helm/helm/releases
HELM_VERSION="v4.3.1"

# Chart Argo CD (application v3.5.6) - https://argoproj.github.io/argo-helm
ARGOCD_CHART_VERSION="10.11.6"

# Nom du cluster k3d
CLUSTER_NAME="securepay"
